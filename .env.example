# Create a Nebius Token Factory API key in your Nebius account.
NEBIUS_API_KEY=your-token-factory-api-key
# OpenAI-compatible API base URL. Keep the /v1 suffix.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Change to a Nemotron model available to your Token Factory account.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
PORT=3000
